# Variáveis públicas do Supabase para o cliente web
# REGRA DE OURO: NUNCA coloque SUPABASE_SERVICE_ROLE_KEY, DINO_RUN_HMAC_SECRET ou senhas aqui!
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_SUA_CHAVE_PUBLICA_AQUI

# Domínio(s) oficiais permitidos pela trava anti-cópia no navegador (separados por vírgula)
VITE_ALLOWED_DOMAINS=dino-dash-3d-six.vercel.app

# Feature flag arquitetural (ECA Digital / Lei 15.211/2025): manter false na versão pública gratuita
VITE_LOOTBOX_REAL_MONEY=false

# Edição da build: public (gratuita oficial) ou private (ambiente fechado/testes)
VITE_APP_EDITION=public

# Ativar login anônimo automático somente após habilitar "Anonymous Sign-Ins" no painel do Supabase
VITE_ENABLE_ANON_AUTH=false

# Porta opcional do servidor LAN local (npm run host)
LAN_PORT=5174
